# ─── Huele Rico! storefront configuration (local development) ──────────
# Copy this file to .env.local and fill in the values.
# If the Shopify values are empty, the site runs in DEMO MODE with a sample
# catalog. On GitHub Pages these come from the repository's Actions
# secrets and variables instead (see README → "Go live on GitHub Pages").

# Public site URL (canonical URLs, sitemap, social previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only needed when the site is served from a sub-folder, e.g. /huele-rico-ecommerce-claude
NEXT_PUBLIC_BASE_PATH=

# Shopify store domain — the *.myshopify.com domain, NOT your custom domain
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# PUBLIC Storefront API access token (from Shopify's Headless channel).
# This token is meant to be used in the browser: it can read products and
# manage carts only. Never put an Admin API token here.
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

NEXT_PUBLIC_SHOPIFY_API_VERSION=2026-07

# Optional
NEXT_PUBLIC_CONTACT_EMAIL=hola@huelerico.com
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Optional: newsletter sign-ups are POSTed as JSON ({ email, tags, source }) to
# this URL (Klaviyo, Shopify Flow, Zapier, Make…). The sign-up form stays
# hidden on the live site until this is set.
NEXT_PUBLIC_NEWSLETTER_WEBHOOK_URL=

# Optional: contact-form messages are POSTed as JSON ({ name, email, order, message }).
# Without it, the contact page shows an "Email Us" button instead.
NEXT_PUBLIC_CONTACT_WEBHOOK_URL=

# Optional: WhatsApp number for the floating chat button, international format
# with country code, e.g. 15551234567. Leave empty to hide the button.
NEXT_PUBLIC_WHATSAPP_NUMBER=
