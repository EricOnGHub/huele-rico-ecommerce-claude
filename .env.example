# ─── Huele Rico! storefront configuration ───────────────────────────────
# Copy this file to .env.local and fill in the values.
# If the Shopify values are left empty, the site runs in DEMO MODE
# with a sample catalog so you can preview the design.

# Your public site URL (used for SEO: canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.huelerico.com

# Shopify store domain — the *.myshopify.com domain, NOT your custom domain
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API access token (Shopify admin → Settings → Apps and sales channels
# → Develop apps / Headless channel → Storefront API access token)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Storefront API version (https://shopify.dev/docs/api/usage/versioning)
SHOPIFY_API_VERSION=2026-07

# Secret used to authenticate Shopify webhooks that refresh cached products.
# Use the same random string in the webhook URL: /api/revalidate?secret=...
SHOPIFY_REVALIDATION_SECRET=

# Optional social profile links (shown in footer and in SEO structured data)
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/huelerico
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@huelerico
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_CONTACT_EMAIL=hola@huelerico.com

# Optional: newsletter sign-ups are POSTed as JSON ({ email, source, tags }) to
# this URL (Klaviyo, Shopify Flow, Zapier, Make, etc.). The sign-up form is
# hidden on the live site until this is set.
NEWSLETTER_WEBHOOK_URL=

# Optional: contact-form messages are POSTed as JSON ({ name, email, order, message })
# to this URL. Without it, the contact page shows your email address instead.
CONTACT_WEBHOOK_URL=
